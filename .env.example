# Copy this file to .env and fill in your values. Never share or commit .env.

GNANI_API_KEY=your-gnani-api-key
TELEGRAM_TOKEN=your-token-from-BotFather

# Speech settings (see the Gnani docs Voice Catalog for voices in your language)
STT_MODEL=prisma-v3.0
STT_LANGUAGE=indic-auto
TTS_MODEL=timbre-v2.5
TTS_VOICE=Nalini
TTS_LANGUAGE=hi-IN

# Optional: LLM for deeper analysis (OpenAI-compatible endpoint, e.g. a hosted Evon).
# Leave blank to use the built-in rule engine.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 1 = save transcripts in the local database. Default 0 (privacy: only scores are saved).
STORE_TRANSCRIPTS=0
